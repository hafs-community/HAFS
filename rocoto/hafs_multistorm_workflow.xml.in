          <not><datadep><cyclestr>&COMhafs;/storm5.conf</cyclestr></datadep></not>
        </or>
        <or>
          <taskdep task="atm_init_storm6"/>
          <strneq><left>&RUN_ATM_INIT;</left><right>YES</right></strneq>
          <not><datadep><cyclestr>&COMhafs;/storm6.conf</cyclestr></datadep></not>
        </or>
        <or>
          <taskdep task="atm_init_storm7"/>
          <strneq><left>&RUN_ATM_INIT;</left><right>YES</right></strneq>
          <not><datadep><cyclestr>&COMhafs;/storm7.conf</cyclestr></datadep></not>
        </or>
@** else
        <or>
          <taskdep task="atm_vi_storm2"/>
          <strneq><left>&RUN_ATM_VI;</left><right>YES</right></strneq>
          <not><datadep><cyclestr>&COMhafs;/storm2.conf</cyclestr></datadep></not>
        </or>
        <or>
          <taskdep task="analysis_storm2"/>
          <strneq><left>&RUN_ANALYSIS;</left><right>YES</right></strneq>
          <not><datadep><cyclestr>&COMhafs;/storm2.conf</cyclestr></datadep></not>
        </or>
        <or>
          <taskdep task="atm_vi_storm3"/>
          <strneq><left>&RUN_ATM_VI;</left><right>YES</right></strneq>
          <not><datadep><cyclestr>&COMhafs;/storm3.conf</cyclestr></datadep></not>
        </or>
        <or>
          <taskdep task="analysis_storm3"/>
          <strneq><left>&RUN_ANALYSIS;</left><right>YES</right></strneq>
          <not><datadep><cyclestr>&COMhafs;/storm3.conf</cyclestr></datadep></not>
        </or>
        <or>
          <taskdep task="atm_vi_storm4"/>
          <strneq><left>&RUN_ATM_VI;</left><right>YES</right></strneq>
