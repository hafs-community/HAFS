<?xml version="1.0"?>

<!DOCTYPE workflow [

  <!-- Set some variables for use later: -->

  <!ENTITY COM_SCRUB_TIME "10800">
  <!ENTITY WORK_SCRUB_TIME "3600">
  <!ENTITY CYCLE_THROTTLE "8">
  <!ENTITY TASK_THROTTLE "160"> <!-- LJG 2026/5/29 *160*: was 120 -->

  <!-- Maximum number of times to try various jobs -->
  <!ENTITY MAX_TRIES_TRANSFER "6"> <!-- pulling data over network -->
  <!ENTITY MAX_TRIES_BIG_JOBS "1"> <!-- forecast or other huge jobs -->
  <!ENTITY MAX_TRIES "2"> <!-- everything else: LJG 2026/5/29 *2* -->

 <!-- Extra variables to send to the exhwrf_launch.py -->
  <!ENTITY MORE_LAUNCH_VARS "@[MORE_LAUNCH_VARS]">

  <!-- Multistorm IDs -->
  <!ENTITY MULTISTORM "@[MULTISTORM==YES?YES:NO]">
  <!ENTITY BASINS "@[BASINS:-]">
  <!ENTITY MULTISTORM_SIDS "@[MULTISTORM_SIDS:-]">
  <!ENTITY RENUM "@[RENUM:-]">
  <!ENTITY FAKE_STORM "storm1">
  <!ENTITY STORMS "storm1 storm2 storm3 storm4 storm5 storm6 storm7">
  <!ENTITY RES_STORM_NOS "s1 s2 s3 s4 s5 s6 s7">
  <!ENTITY REAL_STORMS "storm2 storm3 storm4 storm5 storm6 storm7">
  <!ENTITY CYCLEDA_STORMS "storm2 storm3 storm4 storm5 storm6 storm7">

  <!-- Storm we are going to run -->
  <!ENTITY SID "@[SID.uc]">
  <!ENTITY sidlc "@[SID.lc]">
  <!ENTITY STORMLABEL "@[stormlabel]">
  <!ENTITY CASE_ROOT "@[CASE_ROOT]">

  <!-- scrub config -->
  <!ENTITY SCRUB_WORK "@[SCRUB_WORK]">
  <!ENTITY SCRUB_COM "@[SCRUB_COM]">

  <!-- Directory paths and experiment names. -->
  <!ENTITY WHERE_AM_I "@[WHERE_AM_I]">
  <!ENTITY PRE      "@[USHhafs]/rocoto_pre_job.sh">
  <!ENTITY RUN      "@[RUN]">
  <!ENTITY EXPT     "@[EXPT]">
  <!ENTITY SUBEXPT  "@[SUBEXPT:-EXPT]">
  <!ENTITY HOMEhafs "@[CDSAVE]/&EXPT;">
  <!ENTITY PARMhafs "@[PARMhafs:-&HOMEhafs;/parm]">
  <!ENTITY JOBhafs  "@[JOBhafs:-&HOMEhafs;/jobs]">
  <!ENTITY EXhafs   "@[EXhafs:-&HOMEhafs;/scripts]">
  <!ENTITY USHhafs  "@[USHhafs:-&HOMEhafs;/ush]">
  <!ENTITY FIXhafs  "&HOMEhafs;/fix">
  <!ENTITY EXEChafs "&HOMEhafs;/exec">
  <!ENTITY WORKhafs "@[CDSCRUB]/&SUBEXPT;/@Y@m@d@H/&SID;">
  <!ENTITY COMhafs  "@[CDSCRUB]/&SUBEXPT;/com/@Y@m@d@H/&SID;">
  <!ENTITY LOGhafs  "@[CDSCRUB]/&SUBEXPT;/log">

  <!ENTITY GFSVER   "@[GFSVER:-PROD2026]">
  <!ENTITY COMgfs   "@[COMgfs:-&WORKhafs;/hafsdata]">
  <!ENTITY COMrtofs "@[COMrtofs:-&WORKhafs;/hafsdata]">

  <!-- The output conf file for each cycle: -->
  <!ENTITY CONFhafs "&COMhafs;/&STORMLABEL;.conf">
  <!ENTITY HOLDVARS "&COMhafs;/&STORMLABEL;.holdvars.txt">

  <!-- Enabling or disabling  parts of the workflow: -->
  <!ENTITY FETCH_INPUT "@[FETCH_INPUT]">
  <!ENTITY RUN_ATM_MVNEST "@[RUN_ATM_MVNEST]">
  <!ENTITY RUN_ATM_MVNEST_ENS "@[RUN_ATM_MVNEST_ENS]">
  <!ENTITY RUN_ATM_INIT "@[RUN_ATM_INIT]">
  <!ENTITY RUN_ATM_INIT_FGAT "@[RUN_ATM_INIT_FGAT]">
  <!ENTITY RUN_ATM_INIT_ENS "@[RUN_ATM_INIT_ENS]">
  <!ENTITY RUN_ATM_MERGE "@[RUN_ATM_MERGE]">
  <!ENTITY RUN_ATM_MERGE_FGAT "@[RUN_ATM_MERGE_FGAT]">
  <!ENTITY RUN_ATM_MERGE_ENS "@[RUN_ATM_MERGE_ENS]">
  <!ENTITY RUN_ATM_VI "@[RUN_ATM_VI]">
  <!ENTITY RUN_ATM_VI_FGAT "@[RUN_ATM_VI_FGAT]">
  <!ENTITY RUN_ATM_VI_ENS "@[RUN_ATM_VI_ENS]">
  <!ENTITY RUN_FGAT "@[RUN_FGAT]">
  <!ENTITY ANALYSIS_MODEL "@[ANALYSIS_MODEL]">
  <!ENTITY DIRECT_GDASENS "@[DIRECT_GDASENS]">
  <!ENTITY RUN_ANALYSIS "@[RUN_ANALYSIS]">
  <!ENTITY ANALYSIS_D01 "@[ANALYSIS_D01]">
  <!ENTITY ANALYSIS_D02 "@[ANALYSIS_D02]">
  <!ENTITY ANALYSIS_D03 "@[ANALYSIS_D03]">
  <!ENTITY RUN_ENSDA "@[RUN_ENSDA]">
  <!ENTITY RUN_ENKF "@[RUN_ENKF]">
  <!ENTITY RUN_ANALYSIS_MERGE "@[RUN_ANALYSIS_MERGE]">
  <!ENTITY RUN_ANALYSIS_MERGE_ENS "@[RUN_ANALYSIS_MERGE_ENS]">
  <!ENTITY RUN_OCEAN "@[RUN_OCEAN]">
  <!ENTITY RUN_WAVE "@[RUN_WAVE]">
  <!ENTITY RUN_DATM "@[RUN_DATM]">
  <!ENTITY RUN_DOCN "@[RUN_DOCN]">
  <!ENTITY RUN_GEMPAK "@[RUN_GEMPAK:-NO]">
  <!ENTITY RUN_HRDGRAPHICS "@[RUN_HRDGRAPHICS:-NO]">
  <!ENTITY RUN_EMCGRAPHICS "@[RUN_EMCGRAPHICS:-NO]">
  <!ENTITY MAKE_MESH_ATM "@[MAKE_MESH_ATM]">
  <!ENTITY MAKE_MESH_OCN "@[MAKE_MESH_OCN]">

  <!ENTITY ENS_SIZE "@[ENS_SIZE]">
  <!ENTITY ENSIDS "@[ENSIDS]">

  <!ENTITY gtype "@[gtype:-regional]">
  <!ENTITY ATM_INIT_0_RESOURCES "&@[ATM_INIT_0_RESOURCES:-ATM_INIT_RESOURCES];">
  <!ENTITY ATM_INIT_1_RESOURCES "&@[ATM_INIT_1_RESOURCES:-ATM_INIT_RESOURCES];">
  <!ENTITY ATM_INIT_2_RESOURCES "&@[ATM_INIT_2_RESOURCES:-ATM_INIT_RESOURCES];">
  <!ENTITY ATM_INIT_3_RESOURCES "&@[ATM_INIT_3_RESOURCES:-ATM_INIT_RESOURCES];">
  <!ENTITY ATM_INIT_4_RESOURCES "&@[ATM_INIT_4_RESOURCES:-ATM_INIT_RESOURCES];">
  <!ENTITY ATM_INIT_5_RESOURCES "&@[ATM_INIT_5_RESOURCES:-ATM_INIT_RESOURCES];">
  <!ENTITY ATM_INIT_6_RESOURCES "&@[ATM_INIT_6_RESOURCES:-ATM_INIT_RESOURCES];">
  <!ENTITY FORECAST_RESOURCES "&@[FORECAST_RESOURCES:-FORECAST_RESOURCES_300PE];">
  <!ENTITY FORECAST_0_RESOURCES "&@[FORECAST_0_RESOURCES:-FORECAST_RESOURCES_300PE];">
  <!ENTITY FORECAST_1_RESOURCES "&@[FORECAST_1_RESOURCES:-FORECAST_RESOURCES_300PE];">
  <!ENTITY FORECAST_2_RESOURCES "&@[FORECAST_2_RESOURCES:-FORECAST_RESOURCES_300PE];">
  <!ENTITY FORECAST_3_RESOURCES "&@[FORECAST_3_RESOURCES:-FORECAST_RESOURCES_300PE];">
  <!ENTITY FORECAST_4_RESOURCES "&@[FORECAST_4_RESOURCES:-FORECAST_RESOURCES_300PE];">
  <!ENTITY FORECAST_5_RESOURCES "&@[FORECAST_5_RESOURCES:-FORECAST_RESOURCES_300PE];">
  <!ENTITY FORECAST_6_RESOURCES "&@[FORECAST_6_RESOURCES:-FORECAST_RESOURCES_300PE];">
<!--
  <!ENTITY FORECAST_ENS_RESOURCES "&@[FORECAST_ENS_RESOURCES:-FORECAST_RESOURCES_300PE];">
-->

  <!-- CPU account name -->
  <!ENTITY CPU_ACCOUNT "@[CPU_ACCOUNT]">

  <!-- Load the env_vars.ent into ENV_VARS so we can set variables
  common to all jobs. -->
  <!ENTITY ENV_VARS SYSTEM "env_vars.ent">

  <!-- Site that we are currently running on -->
  <!ENTITY % SITES    SYSTEM "sites/all.ent">
  %SITES;

  <!ENTITY % SITE_DEFAULTS SYSTEM "sites/defaults.ent">
  %SITE_DEFAULTS;

@** if SITE_FILE==
  <!-- No site file, so choose from defaults. -->
@**   if WHERE_AM_I==jet
@**     if WHICH_JET==t
  %tjet;
@**     elseif WHICH_JET==u
  %ujet;
@**     elseif WHICH_JET==s
  %sjet;
@**     elseif WHICH_JET==v
  %vjet;
@**     elseif WHICH_JET==x
  %xjet;
@**     elseif WHICH_JET==k
  %kjet;
@**     else
  %xjet; <!-- Default is xjet when nothing else is specified -->
@**     endif
@**   else
  %@[WHERE_AM_I];
@**   endif
@** else
  <!ENTITY % CUSTOM_SITE SYSTEM "@[SITE_FILE]">
  %CUSTOM_SITE;
@** endif

]>

<!-- Workflow below here -->

<workflow realtime="F" cyclethrottle="&CYCLE_THROTTLE;"
          scheduler="&SCHEDULER;" taskthrottle="&TASK_THROTTLE;">

  @[CYCLE_LIST]

  <log><cyclestr>&LOGhafs;/rocoto_@Y@m@d@H.log</cyclestr></log>

  <task name="launch" maxtries="99">
    <!--<command>&PRE; &EXhafs;/exhafs_launch.py &SID; <cyclestr>@Y@m@d@H</cyclestr></command>-->
    <command>&PRE; &EXhafs;/exhafs_launch.py &MULTISTORM_SIDS; &BASINS; &RENUM; <cyclestr>@Y@m@d@H &SID; &CASE_ROOT; '&PARMhafs;' config.EXPT='&EXPT;' config.SUBEXPT='&SUBEXPT;' config.HOMEhafs='&HOMEhafs;' dir.USHhhafs='&USHhafs;' &MORE_LAUNCH_VARS; </cyclestr></command>
    <jobname>hafs_launch_&SID;_<cyclestr>@Y@m@d@H</cyclestr></jobname>
    <join><cyclestr>&WORKhafs;/hafs_launch.log</cyclestr></join>
    <account>&ACCOUNT;</account>
    &RESERVATION;
    <queue>&QUEUE_PE;</queue>
    &PE_EXTRA;
    &CLUSTER_COMPUTE;
    &CORES_EXTRA;
    &LAUNCH_RESOURCES;
    &ENV_VARS;

    <dependency>
      <and>
        <!-- Cycling dependency: do not start until the prior cycle's
        launch job is done, unless there is no prior cycle. -->
        <or>
          <taskdep task="launch" cycle_offset="-6:00:00"/>
          <not>
            <cycleexistdep cycle_offset="-6:00:00"/>
          </not>
        </or>
        <!-- AND... don't start until 3:20 past the synoptic time.  The
        GFS does not start until then, so there is little point to
        starting earlier. -->
        <timedep><cyclestr offset="3:20:00">@Y@m@d@H@M@S</cyclestr></timedep>
      </and>
    </dependency>

    <!--
    <rewind>
      <sh>&USHhafs;/hafs_scrub.py '<cyclestr>&COMhafs;</cyclestr>' '<cyclestr>&WORKhafs;</cyclestr>'</sh>
    </rewind>
    -->
  </task>

  <task name="input" maxtries="&MAX_TRIES_TRANSFER;">
    <command>&PRE; &EXhafs;/exhafs_input.py</command>
    <jobname>hafs_input_&SID;_<cyclestr>@Y@m@d@H</cyclestr></jobname>
    <join><cyclestr>&WORKhafs;/hafs_input.log</cyclestr></join>
    <account>&ACCOUNT;</account>
    &RESERVATION;
    <queue>&QUEUE_SERVICE;</queue>
    &SERVICE_EXTRA;
    <cores>1</cores>
    &CORES_EXTRA;
    &CLUSTER_COMPUTE;
    <envar><name>TOTAL_TASKS</name><value>1</value></envar>
    <walltime>06:00:00</walltime>
    &MEMORY;
    &ENV_VARS;

    <dependency>
      <and>
        <taskdep task="launch"/>
        <streq><left>&FETCH_INPUT;</left><right>YES</right></streq>
        <streq><left>&RUN_DATM;</left><right>NO</right></streq>
      </and>
    </dependency>
  </task>

  <metatask name="atm_prep_meta">
  <var name="storm">&STORMS;</var>
  
  <task name="atm_prep_#storm#" maxtries="&MAX_TRIES;">
    <command>&JOBhafs;/JHAFS_ATM_PREP</command>
    <jobname>hafs_atm_prep_&SID;_<cyclestr>@Y@m@d@H</cyclestr>_#storm#</jobname>
    <join><cyclestr>&WORKhafs;/hafs_atm_prep_#storm#.log</cyclestr></join>
    <account>&ACCOUNT;</account>
    &RESERVATION;
    <queue>&QUEUE_PE;</queue>
    &PE_EXTRA;
    &CLUSTER_COMPUTE;
    &CORES_EXTRA;
    &ATM_PREP_RESOURCES;
    &ENV_VARS;
    <envar>
      <name>HOLDVARS</name>
      <value><cyclestr>&COMhafs;/#storm#.holdvars.txt</cyclestr></value>
    </envar>

    <dependency>
      <and>
        <taskdep task="launch"/>
        <datadep><cyclestr>&COMhafs;/#storm#.conf</cyclestr></datadep>
      </and>
    </dependency>
  </task>

@** if RUN_ATM_MVNEST==YES
  <task name="atm_prep_mvnest" maxtries="&MAX_TRIES;">
    <command>&JOBhafs;/JHAFS_ATM_PREP</command>
    <jobname>hafs_atm_prep_mvnest_&SID;_<cyclestr>@Y@m@d@H</cyclestr></jobname>
    <join><cyclestr>&WORKhafs;/hafs_atm_prep_mvnest.log</cyclestr></join>
    <account>&ACCOUNT;</account>
    &RESERVATION;
    <queue>&QUEUE_PE;</queue>
    &PE_EXTRA;
    &CLUSTER_COMPUTE;
    &CORES_EXTRA;
    &ATM_PREP_RESOURCES;
    &ENV_VARS;
    <envar><name>ATM_PREP_MVNEST</name><value>YES</value></envar>

    <dependency>
      <and>
        <taskdep task="launch"/>
        <!-- Lew.Gramer@noaa.gov 2024-08-22 -->
        <!-- For HFSM: Succeeding cycles depend on the fix files generated by the first prep_mvnest -->
        <or>
          <not><cycleexistdep cycle_offset="-6:00:00"/></not>
          <taskdep task="atm_prep_mvnest" cycle_offset="-6:00:00"/>
        </or>
        <!-- Lew.Gramer@noaa.gov 2024-08-22 -->
      </and>
    </dependency>
  </task>
<!-- if RUN_ATM_MVNEST==YES -->
@** endif

  <task name="atm_ic_#storm#" maxtries="&MAX_TRIES;">
    <command>&JOBhafs;/JHAFS_ATM_IC</command>
    <jobname>hafs_atm_ic_&SID;_<cyclestr>@Y@m@d@H</cyclestr>_#storm#</jobname>
    <join><cyclestr>&WORKhafs;/hafs_atm_ic_#storm#.log</cyclestr></join>
    <account>&ACCOUNT;</account>
    &RESERVATION;
    <queue>&QUEUE_PE;</queue>
    &PE_EXTRA;
    &CLUSTER_COMPUTE;
    &CORES_EXTRA;
    &ATM_IC_RESOURCES;
    &ENV_VARS;
    <envar>
      <name>HOLDVARS</name>
      <value><cyclestr>&COMhafs;/#storm#.holdvars.txt</cyclestr></value>
    </envar>

    <dependency>
      <and>
        <taskdep task="atm_prep_#storm#"/>
        <streq><left>&RUN_DATM;</left><right>NO</right></streq>
        <or>
          <taskdep task="input"/>
          <strneq><left>&FETCH_INPUT;</left><right>YES</right></strneq>
        </or>
        <!-- Second dependency: the GFS output must be available -->
        <timedep><cyclestr offset="3:25:00">@Y@m@d@H@M@S</cyclestr></timedep>
        <!-- Or use COMgfs file dependency. Don't start until GFS analysis is available.-->
        <and>
@** if GFSVER==PROD2026
          <datadep age="02:00" minsize="12000000000"><cyclestr>&COMgfs;/gfs.@Y@m@d/@H/analysis/atmos/gfs.t@Hz.analysis.atm.a006.nc</cyclestr></datadep>
          <datadep age="02:00" minsize="200000000"><cyclestr>&COMgfs;/gfs.@Y@m@d/@H/analysis/atmos/gfs.t@Hz.analysis.sfc.a006.nc</cyclestr></datadep>
@** endif
@** if GFSVER==PROD2021
          <datadep age="02:00" minsize="12000000000"><cyclestr>&COMgfs;/gfs.@Y@m@d/@H/atmos/gfs.t@Hz.atmanl.nc</cyclestr></datadep>
          <datadep age="02:00" minsize="200000000"><cyclestr>&COMgfs;/gfs.@Y@m@d/@H/atmos/gfs.t@Hz.sfcanl.nc</cyclestr></datadep>
@** endif
        </and>
      </and>
    </dependency>
  </task>

  </metatask> <!-- atm_prep_meta -->

@** if gtype==regional

  <metatask name="atm_init_meta">
  <var name="real_storm">&REAL_STORMS;</var>

@** if RUN_ATM_INIT_FGAT==YES
  <metatask name="atm_ic_fgat_#real_storm#">
  <var name="FGAT_HR">03 06 09</var>
  <task name="atm_ic_fgat#FGAT_HR#_#real_storm#" maxtries="&MAX_TRIES;">
    <command>&JOBhafs;/JHAFS_ATM_IC</command>
    <jobname>hafs_atm_ic_fgat#FGAT_HR#_&SID;_<cyclestr>@Y@m@d@H</cyclestr>_#real_storm#</jobname>
    <join><cyclestr>&WORKhafs;/hafs_atm_ic_fgat#FGAT_HR#_#real_storm#.log</cyclestr></join>
    <account>&ACCOUNT;</account>
    &RESERVATION;
    <queue>&QUEUE_PE;</queue>
    &PE_EXTRA;
    &CORES_EXTRA;
    &CLUSTER_COMPUTE;
    &ATM_IC_RESOURCES;
    &ENV_VARS;
    <envar>
      <name>HOLDVARS</name>
      <value><cyclestr>&COMhafs;/#real_storm#.holdvars.txt</cyclestr></value>
    </envar>
    <envar><name>FGAT_MODEL</name><value>gdas</value></envar>
    <envar><name>FGAT_HR</name><value>#FGAT_HR#</value></envar>

    <dependency>
      <and>
        <taskdep task="atm_prep_#real_storm#"/>
        <streq><left>&RUN_DATM;</left><right>NO</right></streq>
        <or>
          <taskdep task="input"/>
          <strneq><left>&FETCH_INPUT;</left><right>YES</right></strneq>
        </or>
        <!-- Second dependency: the GDAS output must be available -->
        <timedep><cyclestr offset="3:25:00">@Y@m@d@H@M@S</cyclestr></timedep>
        <!-- Or use COMgfs file dependency. Don't start until GFS analysis is available.-->
        <and>
@** if GFSVER==PROD2026
          <datadep age="02:00" minsize="2000000000"><cyclestr offset="-6:00:00">&COMgfs;/gdas.@Y@m@d/@H/model/atmos/history/gdas.t@Hz.atm.f0#FGAT_HR#.nc</cyclestr></datadep>
          <datadep age="02:00" minsize="500000000"><cyclestr offset="-6:00:00">&COMgfs;/gdas.@Y@m@d/@H/model/atmos/history/gdas.t@Hz.sfc.f0#FGAT_HR#.nc</cyclestr></datadep>
@** endif
@** if GFSVER==PROD2021
          <datadep age="02:00" minsize="2000000000"><cyclestr offset="-6:00:00">&COMgfs;/gdas.@Y@m@d/@H/atmos/gdas.t@Hz.atmf0#FGAT_HR#.nc</cyclestr></datadep>
          <datadep age="02:00" minsize="500000000"><cyclestr offset="-6:00:00">&COMgfs;/gdas.@Y@m@d/@H/atmos/gdas.t@Hz.sfcf0#FGAT_HR#.nc</cyclestr></datadep>
@** endif
        </and>
      </and>
    </dependency>
  </task>
  </metatask> <!-- atm_ic_fgat_#real_storm# -->
@** endif

@** if RUN_ENSDA==NO
@**   if ANALYSIS_MODEL==JEDI
@**     if DIRECT_GDASENS==NO
  <task name="ens_prep_#real_storm#" maxtries="&MAX_TRIES;">
    <command>&JOBhafs;/JHAFS_ENS_PREP</command>
    <jobname>hafs_ens_prep_#real_storm#_&SID;_<cyclestr>@Y@m@d@H</cyclestr></jobname>
    <join><cyclestr>&WORKhafs;/hafs_ens_prep_#real_storm#.log</cyclestr></join>
    <envar><name>stormlabel</name><value>#real_storm#</value></envar>
    <account>&ACCOUNT;</account>
    &RESERVATION;
    &MEMORYJEDI;
    <queue>&QUEUE_PE;</queue>
    &PE_EXTRA;
    &CORES_EXTRA;
    &CLUSTER_COMPUTE;
    &ENS_PREP_RESOURCES;
    &ENV_VARS;
    <envar>
      <name>HOLDVARS</name>
      <value><cyclestr>&COMhafs;/#real_storm#.holdvars.txt</cyclestr></value>
    </envar>

    <dependency>
      <and>
        <or>
          <taskdep task="atm_init_#real_storm#"/>
          <taskdep task="atm_vi_#real_storm#"/>
        </or>
        <taskdep task="atm_prep_#real_storm#"/>
        <and>
@** if GFSVER==PROD2021
          <datadep age="02:00" minsize="1000000000"><cyclestr offset="-6:00:00">&COMgfs;/enkfgdas.@Y@m@d/@H/atmos/mem001/gdas.t@Hz.atmf006.nc</cyclestr></datadep>
          <datadep age="02:00" minsize="200000000"><cyclestr offset="-6:00:00">&COMgfs;/enkfgdas.@Y@m@d/@H/atmos/mem001/gdas.t@Hz.sfcf006.nc</cyclestr></datadep>
@** endif
@** if GFSVER==PROD2026
          <datadep age="02:00" minsize="1000000000"><cyclestr offset="-6:00:00">&COMgfs;/enkfgdas.@Y@m@d/@H/mem001/model/atmos/history/enkfgdas.t@Hz.atm.f006.nc</cyclestr></datadep>
          <datadep age="02:00" minsize="200000000"><cyclestr offset="-6:00:00">&COMgfs;/enkfgdas.@Y@m@d/@H/mem001/model/atmos/history/enkfgdas.t@Hz.sfc.f006.nc</cyclestr></datadep>
@** endif
        </and>
      </and>
    </dependency>
  </task>
@**     endif
@**   endif
@** endif

@** if RUN_ATM_INIT==YES
  <task name="atm_init_storm1_0" maxtries="&MAX_TRIES;">
    <command>&JOBhafs;/JHAFS_ATM_INIT</command>
    <jobname>hafs_atm_init_&SID;_<cyclestr>@Y@m@d@H</cyclestr>_storm1_0</jobname>
    <join><cyclestr>&WORKhafs;/hafs_atm_init_storm1_0.log</cyclestr></join>
    <account>&ACCOUNT;</account>
    &RESERVATION;
    <queue>&QUEUE_PE;</queue>
    &PE_EXTRA;
    &CORES_EXTRA;
    &CLUSTER_COMPUTE;
    &ATM_INIT_0_RESOURCES;
    &ENV_VARS;
    <envar>
      <name>HOLDVARS</name>
      <value><cyclestr>&COMhafs;/storm1.holdvars.txt</cyclestr></value>
    </envar>

    <dependency>
      <and>
        <datadep><cyclestr>&COMhafs;/storm1.conf</cyclestr></datadep>
        <not><datadep><cyclestr>&COMhafs;/storm2.conf</cyclestr></datadep></not>
        <taskdep task="atm_ic_storm1"/>
      </and>
    </dependency>
  </task>

  <task name="atm_init_storm1_1" maxtries="&MAX_TRIES;">
    <command>&JOBhafs;/JHAFS_ATM_INIT</command>
    <jobname>hafs_atm_init_&SID;_<cyclestr>@Y@m@d@H</cyclestr>_storm1_1</jobname>
    <join><cyclestr>&WORKhafs;/hafs_atm_init_storm1_1.log</cyclestr></join>
    <account>&ACCOUNT;</account>
    &RESERVATION;
    <queue>&QUEUE_PE;</queue>
    &PE_EXTRA;
    &CORES_EXTRA;
    &CLUSTER_COMPUTE;
    &ATM_INIT_1_RESOURCES;
    &ENV_VARS;
    <envar>
      <name>HOLDVARS</name>
      <value><cyclestr>&COMhafs;/storm1.holdvars.txt</cyclestr></value>
    </envar>

    <dependency>
      <and>
