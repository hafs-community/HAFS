        <and>
@** if GFSVER==PROD2026
          <datadep age="02:00" minsize="300000000"><cyclestr>&COMgfs;/gfs.@Y@m@d/@H/products/atmos/grib2/0p25/gfs.t@Hz.pres_a.0p25.f129.grib2</cyclestr></datadep>
@** endif
@** if GFSVER==PROD2021
          <datadep age="02:00" minsize="300000000"><cyclestr>&COMgfs;/gfs.@Y@m@d/@H/atmos/gfs.t@Hz.pgrb2.0p25.f129</cyclestr></datadep>
@** endif
        </and>
        <or>
          <not><cycleexistdep cycle_offset="-6:00:00"/></not>
	      <and>
            <datadep age="02:00"><cyclestr offset="-6:00:00">&COMhafs;/&sidlc;.@Y@m@d@H</cyclestr>.&RUN;.ww3.restart.f006</datadep>
            <or>
                <datadep age="02:00"><cyclestr offset="-6:00:00">&COMhafs;/&sidlc;.@Y@m@d@H</cyclestr>.&RUN;.trak.atcfunix.f012</datadep>
                <datadep age="02:00"><cyclestr offset="-6:00:00">&COMhafs;/&sidlc;.@Y@m@d@H</cyclestr>.&RUN;.parent.trak.atcfunix.f012</datadep>
            </or>
          </and>
        </or>
      </and>
    </dependency>
  </task>
@** endif

@** if RUN_ANALYSIS==YES

  <task name="obs_prep_#real_storm#" maxtries="&MAX_TRIES;">
    <command>&JOBhafs;/JHAFS_OBS_PREP</command>
    <jobname>hafs_obs_prep_&SID;_<cyclestr>@Y@m@d@H</cyclestr>_#real_storm#</jobname>
    <join><cyclestr>&WORKhafs;/hafs_obs_prep_#real_storm#.log</cyclestr></join>
    <account>&ACCOUNT;</account>
    &RESERVATION;
    <queue>&QUEUE_PE;</queue>
    &PE_EXTRA;
    &CORES_EXTRA;
    &CLUSTER_COMPUTE;
    &OBS_PREP_RESOURCES;
    &ENV_VARS;
    <envar>
      <name>HOLDVARS</name>
      <value><cyclestr>&COMhafs;/#real_storm#.holdvars.txt</cyclestr></value>
    </envar>

    <dependency>
      <or>
        <taskdep task="atm_ic_#real_storm#" state="RUNNING"/>
        <taskdep task="atm_ic_#real_storm#"/>
      </or>
    </dependency>
  </task>

  <task name="analysis_#real_storm#" maxtries="&MAX_TRIES;">
    <command>&JOBhafs;/JHAFS_ANALYSIS</command>
    <jobname>hafs_analysis_&SID;_<cyclestr>@Y@m@d@H</cyclestr>_#real_storm#</jobname>
    <join><cyclestr>&WORKhafs;/hafs_analysis_#real_storm#.log</cyclestr></join>
    <envar><name>ANALYSIS_MODEL</name><value>@[ANALYSIS_MODEL]</value></envar>
    <envar><name>DIRECT_GDASENS</name><value>@[DIRECT_GDASENS]</value></envar>
    <account>&ACCOUNT;</account>
    &RESERVATION;
@** if ANALYSIS_MODEL==JEDI
    &MEMORYJEDI;
@** endif
    <queue>&QUEUE_PE;</queue>
    &PE_EXTRA;
    &CORES_EXTRA;
    &CLUSTER_COMPUTE;
    &ANALYSIS_RESOURCES;
    &ENV_VARS;
    <envar>
      <name>HOLDVARS</name>
      <value><cyclestr>&COMhafs;/#real_storm#.holdvars.txt</cyclestr></value>
    </envar>
    
    <dependency>
      <and>
        <taskdep task="atm_ic_#real_storm#"/>
        <taskdep task="obs_prep_#real_storm#"/>
        <streq><left>&RUN_ANALYSIS;</left><right>YES</right></streq>
@** if RUN_ATM_VI_FGAT==YES
        <or>
          <strneq><left>&RUN_ATM_VI_FGAT;</left><right>YES</right></strneq>
          <metataskdep metatask="atm_vi_fgat_#real_storm#"/>
        </or>
@** else
        <or>
          <taskdep task="atm_vi_#real_storm#"/>
        </or>
@** endif
@** if RUN_ENSDA==YES
        <taskdep task="atm_prep_ens"/>
@**   if RUN_ATM_MERGE_ENS==YES
        <metataskdep metatask="atm_merge_ens"/>
@**   endif
@** elseif DIRECT_GDASENS==NO
@**   if ANALYSIS_MODEL==JEDI
@**     if RUN_ENSDA==NO
          <taskdep task="ens_prep_#real_storm#"/>
@**     endif
@**   endif
@** endif
@** if RUN_ATM_MERGE_FGAT==YES
        <or>
          <strneq><left>&RUN_ATM_MERGE_FGAT;</left><right>YES</right></strneq>
          <metataskdep metatask="atm_merge_fgat_#real_storm#"/>
        </or>
@** endif
        <or>
          <not><cycleexistdep cycle_offset="-6:00:00"/></not>
	      <and>
            <datadep age="02:00"><cyclestr offset="-6:00:00">&COMhafs;/&sidlc;.@Y@m@d@H</cyclestr>.RESTART/<cyclestr>@Y@m@d.@H</cyclestr>0000.fv_core.res.tile1.nc</datadep>
            <datadep age="02:00"><cyclestr offset="-6:00:00">&COMhafs;/&sidlc;.@Y@m@d@H</cyclestr>.RESTART/grid_spec.nc</datadep>
@** if RUN_ENSDA==YES
            <sh>if [[ $(/bin/ls -l <cyclestr offset="-6:00:00">&COMhafs;/&sidlc;.@Y@m@d@H</cyclestr>.RESTART_ens/mem*/<cyclestr>@Y@m@d.@H</cyclestr>0000.fv_core.res.tile1.nc | wc -l) -ge &ENS_SIZE; ]]; then exit 0; else exit 1; fi</sh>
@** endif
          </and>
        </or>
      </and>
    </dependency>
  </task>
@** endif

@** if RUN_ANALYSIS_MERGE==YES
  <task name="analysis_merge" maxtries="&MAX_TRIES;">
    <command>&JOBhafs;/JHAFS_MERGE</command>
    <jobname>hafs_analysis_merge_&SID;_<cyclestr>@Y@m@d@H</cyclestr></jobname>
