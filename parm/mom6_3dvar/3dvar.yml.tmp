# common filters used later on
_: &land_mask
  filter: Domain Check
  where:
  - variable: {name: GeoVaLs/sea_area_fraction}
    minvalue: 0.5

cost function:
  cost type: 3D-Var
  time window:
    begin: DATEmd
    length: P2D
  analysis variables: &soca_an_vars
  - sea_water_salinity
  - sea_water_potential_temperature
  - sea_surface_height_above_geoid

  geometry: &geom
    geom_grid_file: ./soca_gridspec.nc
    mom6_input_nml: ./input.nml
    fields metadata: ./fields_metadata.yml

  background:
    read_from_file: 1
    basename: ./restarts/
    ocn_filename: MOM.res.nc
    date: &bkg_date DATE0d
    state variables: &soca_bg_vars
    - sea_water_salinity
    - sea_water_potential_temperature
    - sea_surface_height_above_geoid
    - sea_water_cell_thickness
    - ocean_mixed_layer_thickness
    - sea_water_depth

  background error:
    covariance model: SABER
    saber central block:
      saber block name: diffusion
      read:
        groups:
        - variables:
          - sea_water_potential_temperature
          - sea_water_salinity
          horizontal:
            filepath: ./parameters_diffusion/diffusion_cor1_hz_HHZ
          vertical:
            levels: 55
            filepath: ./parameters_diffusion/diffusion_cor1_vt_HHZ
        - variables: [sea_surface_height_above_geoid]
          horizontal:
            filepath: ./parameters_diffusion/diffusion_cor1_hz_HHZ
    saber outer blocks:
    - saber block name: StdDev
      read:
        model file:
          datetime: DATE0d
          set datetime on read: true
          basename: ./StdDev/
          ocn_filename: StdDev_double_Time.nc
          date: DATE0d

    date: *bkg_date

    linear variable change:
      input variables: *soca_an_vars
      output variables: *soca_an_vars
      linear variable changes:

      - linear variable change name: BalanceSOCA
        kst:
          dsdtmax: 0.1
          dsdzmin: 3.0e-6
          dtdzmin: 1.0e-6
          nlayers: 10
        ksshts:
          nlayers: 10

  observations:
    observers:
    - obs space:
        name: InsituTemperature
        obsdataout:
          engine:
            type: H5File
            obsfile: data_output/prof_T_YMDH.nc
        obsdatain:
          engine:
            type: H5File
            obsfile: obs/prof_insitu_YMDH.nc
        simulated variables: [waterTemperature]
      obs operator:
        name: InsituTemperature
      obs error:
        covariance model: diagonal
      obs filters:
      - *land_mask
      - filter: Background Check
        threshold: 5

    - obs space:
        name: InsituSalinity
        obsdataout:
          engine:
            type: H5File
            obsfile: data_output/prof_S_YMDH.nc
        obsdatain:
          engine:
            type: H5File
            obsfile: obs/prof_insitu_YMDH.nc
        simulated variables: [salinity]
      obs operator:
        name: VertInterp
        observation alias file: ./obsop_name_map.yml
        vertical coordinate: sea_water_depth
        observation vertical coordinate: depth
        interpolation method: linear
      obs error:
        covariance model: diagonal
      obs filters:
      - *land_mask
    
    - obs space:
        name: SeaSurfaceTemp
        obsdataout:
          engine:
            type: H5File
            obsfile: data_output/sst_satellite_YMDH.nc
        obsdatain:
          engine:
            type: H5File
            obsfile: obs/sst_satellite_YMDH.nc
        simulated variables: [seaSurfaceTemperature]
      obs operator:
        name: Identity
        observation alias file: ./obsop_name_map.yml
      obs error:
        covariance model: diagonal
      obs filters:
      - *land_mask
      - filter: Bounds Check
        minvalue: 5.0
        maxvalue: 35.0
      - filter: Background Check
        threshold: 5
      - filter: Domain Check
        where:
        - variable: {name: ObsError/seaSurfaceTemperature}
          minvalue: 0.001
 
    - obs space:
        name: SeaSurfaceSalinity
        obsdataout:
          engine:
            type: H5File
            obsfile: data_output/sss_salinity_YMDH.nc
        obsdatain:
          engine:
            type: H5File
            obsfile: obs/sss_salinity_YMDH.nc
        simulated variables: [seaSurfaceSalinity]
      obs operator:
        name: Identity
        observation alias file: ./obsop_name_map.yml
      obs error:
        covariance model: diagonal
      obs filters:
      - *land_mask
      - filter: Bounds Check
        minvalue: 0.1
        maxvalue: 40.0
      - filter: Background Check
        threshold: 5.0
      - filter: Domain Check
        where:
        - variable: {name: GeoVaLs/sea_surface_temperature}
          minvalue: 15

    - obs space:
        name: ADT
        obsdataout:
          engine:
            type: H5File
            obsfile: data_output/adt_ssh_YMDH.nc
        obsdatain:
          engine:
            type: H5File
            obsfile: obs/adt_ssh_YMDH.nc
        simulated variables: [absoluteDynamicTopography]
      obs operator:
        name: ADT
      obs error:
        covariance model: diagonal
      obs filters:
      - *land_mask
      - filter: Background Check
        absolute threshold: 0.2

variational:
  minimizer:
    algorithm: RPCG
  iterations:
  - geometry: *geom
    ninner: 100
    gradient norm reduction: 1e-3

output:
  datadir: data_output
  exp: 3dvar
  type: an

